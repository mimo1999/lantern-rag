APP_ENV=development
JWT_ISSUER=permission-aware-rag
# Required outside development: a random value of 32+ characters (the app refuses to start otherwise).
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=60
# Failed sign-ins before an account is locked until a password reset by email.
LOGIN_MAX_ATTEMPTS=3
PASSWORD_RESET_TTL_MINUTES=30
# Requests per tenant per minute across all authenticated endpoints; 0 turns it off.
TENANT_RATE_LIMIT_PER_MINUTE=120
# Reset emails. Without SMTP_HOST, development logs the link and other environments send nothing.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com

# Use localhost for `uv run uvicorn` with Ollama on the host. Inside Compose, the API
# reaches the host's Ollama by default (http://host.docker.internal:11434);
# for its own bundled Ollama set OLLAMA_URL_DOCKER=http://ollama:11434 and use --profile bundled-ollama.
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=all-minilm:22m
# Must equal the vector(N) column type (see app/db/migrations). all-minilm:22m outputs 384.
EMBEDDING_DIMENSION=384
# all-minilm reads at most 512 tokens; keep chunks well under that.
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
LLM_MODEL=gemma4:e2b
# Tables and image captions from PDFs: their own embedding model and vector table
# (vector(1024) in migration 006), and a vision model that captions each image.
ASSET_EMBEDDING_MODEL=bge-m3
ASSET_EMBEDDING_DIMENSION=1024
ASSET_TOP_K=3
VISION_MODEL=gemma4:e2b
TOP_K=20
# Drop results scoring below this fraction of the query's best result. Tuned for
# all-minilm:22m; retune per model.
RETRIEVAL_RELATIVE_CUTOFF=0.4
MAX_CONTEXT_CHARS=12000
MAX_UPLOAD_BYTES=10485760

# PostgreSQL with the pgvector extension (Compose overrides the host to its `postgres` service).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=permission_aware_rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Observability.
LOG_LEVEL=INFO
# METRICS_TOKEN=          # if set, GET /metrics requires "Authorization: Bearer <token>"
